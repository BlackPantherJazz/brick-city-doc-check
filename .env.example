# Copy this file to .env and fill in ONE key.
# Leave both keys empty to run in MOCK MODE (sample data, no AI calls).

# Which AI to use: gemini or claude (blank = whichever key is filled in)
AI_PROVIDER=gemini

# Free: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

PORT=3001
